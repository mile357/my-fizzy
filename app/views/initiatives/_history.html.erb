<div id="initiative_history_<%= initiative.id %>" class="full-width margin-block-start-half">
  <div class="flex justify-space-between align-center margin-block-end-half">
    <h4 class="txt-small font-weight-bold uppercase opacity-75 margin-none">
      Initiative History
    </h4>
    <span class="txt-small opacity-75">
      <%= initiative.activities.count %> <%= "event".pluralize(initiative.activities.count) %>
    </span>
  </div>

  <% if initiative.activities.any? %>
    <div class="initiative-history-list">
      <% initiative.activities.includes(:creator).each do |activity| %>
        <div class="initiative-history-item flex align-start gap-half pad-quarter">
          <div class="flex-shrink-0" style="padding-top: 2px;">
            <% if activity.creator %>
              <%= avatar_preview_tag activity.creator, class: "avatar--tiny", title: activity.creator.name %>
            <% else %>
              <span class="avatar avatar--tiny">?</span>
            <% end %>
          </div>
          <div class="flex flex-column flex-grow min-width txt-small">
            <div class="txt-break" style="line-height: 1.3;">
              <strong class="font-weight-semibold"><%= activity.creator == Current.user ? "You" : (activity.creator&.name || "Someone") %></strong>
              <span class="opacity-90"><%= activity.description.sub(/\A(Created|Added|Completed|Reopened|Removed|Changed|Scheduled|Set|Cleared)/, &:downcase) %></span>
            </div>
            <span class="txt-xx-small opacity-50 margin-block-start-quarter">
              <%= time_ago_in_words(activity.created_at) %> ago
            </span>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="txt-x-small opacity-60 italic margin-none">No history recorded yet for this initiative.</p>
  <% end %>
</div>
